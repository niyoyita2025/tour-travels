# Copy to .env (never commit .env). Load these as environment variables before running Django.

# Set to 0 in production.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Database. Leave empty for local development (SQLite, db.sqlite3). In production, set this to the
# PostgreSQL connection string, e.g. postgres://USER:PASSWORD@HOST:5432/DBNAME
# On Render, use the database's Internal Database URL.
DATABASE_URL=

# Email. Development can use the console backend (emails print to the terminal).
# Real delivery uses Gmail SMTP. EMAIL_HOST_PASSWORD must be a Google "app password" (16 characters,
# created at myaccount.google.com > Security > 2-Step Verification > App passwords), never your normal
# Gmail password. Keep it only in this .env file, which is never committed.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=niyoyitarobert019@gmail.com
EMAIL_HOST_PASSWORD=paste-the-16-character-app-password-here
EMAIL_USE_TLS=1
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Explore Rwanda <niyoyitarobert019@gmail.com>

# WhatsApp number, contact details, payment instructions and the staff notification
# email are set in the staff dashboard under Website content > Site text & contact.

# Booking and password recovery rules (minutes or hours, as named):
BOOKING_HOLD_HOURS=48
CANCELLATION_NOTICE_HOURS=48
LIMITED_SEATS_THRESHOLD=3
PASSWORD_RESET_MINUTES=60

# Production only (requires HTTPS):
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0



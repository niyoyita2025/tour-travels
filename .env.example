# Copy this file to .env and fill in the blanks. Never commit .env (it is in .gitignore).
# Variables already set in the environment (for example on Render) take priority over .env.
# On Render, set these in the service's Environment tab instead; render.yaml sets most of them.

# ---- Django core -------------------------------------------------------------------------------
# 1 for local development, 0 in production.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Any long random string, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated host names. On Render the service's own .onrender.com host is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with https://) allowed to submit forms, e.g. https://your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Base address used in emailed links. On Render it defaults to the service's address.
SITE_URL=http://127.0.0.1:8000

# ---- Database ----------------------------------------------------------------------------------
# Empty = SQLite (db.sqlite3), for local development only.
# Production: PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@HOST:5432/DBNAME
# (on Render, the database's Internal Database URL; render.yaml wires it automatically).
DATABASE_URL=

# ---- Email (Gmail SMTP) ------------------------------------------------------------------------
# Sign-up codes, forgot-password codes and admin reset links are sent through this Gmail account.
# EMAIL_HOST_PASSWORD must be a Google APP PASSWORD (16 characters), never the normal Gmail password:
#   myaccount.google.com > Security > turn on 2-Step Verification > App passwords > create one.
# If it is empty, `manage.py check` and runserver print warning Tour_travels.W002 and no email is sent.
# Test with:  python manage.py send_test_email you@example.com
# To print emails in the terminal instead of sending them, use
#   DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=niyoyitarobert019@gmail.com
EMAIL_HOST_PASSWORD=
# Must be the same address as EMAIL_HOST_USER, or Gmail rewrites it.
DEFAULT_FROM_EMAIL=Explore Rwanda <niyoyitarobert019@gmail.com>

# ---- Email through Brevo (optional; replaces Gmail when the key is set) -----------------------
# Create an API key in Brevo > SMTP & API > API keys and paste it here (it starts with xkeysib-).
# Never commit it. Verify the sender address in Brevo > Senders, Domains & IPs > Senders.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=niyoyitarobert1@gmail.com
BREVO_SENDER_NAME=Explore Rwanda

# ---- Administrator account (optional) ----------------------------------------------------------
# Used by `python manage.py createsuperuser --noinput` and by build.sh on Render (first deploy).
# The email must not belong to another account.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ---- Booking and password-recovery rules -------------------------------------------------------
BOOKING_HOLD_HOURS=48
CANCELLATION_NOTICE_HOURS=48
LIMITED_SEATS_THRESHOLD=3
PASSWORD_RESET_MINUTES=60

# ---- Production only (requires HTTPS) ----------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# WhatsApp number, contact details, payment instructions and the staff notification email are set
# in the staff dashboard under Website content > Site text & contact.
